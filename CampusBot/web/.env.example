# Copiez ce fichier en .env.local et adaptez.
# .env.local reste sur le serveur : ne mettez JAMAIS de préfixe NEXT_PUBLIC_ sur la clé.

# Fournisseur : "ollama" (local, par défaut) ou "anthropic"
PROVIDER=ollama

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Anthropic (seulement si PROVIDER=anthropic)
API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Messages autorisés par minute et par adresse IP
RATE_LIMIT_PER_MIN=10
